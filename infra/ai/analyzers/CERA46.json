{
  "analyzerId": "CERA46",
  "description": "Analyzer para CERA46 (IAE)",
  "tags": {
    "projectId": "246552b6-ae9f-42f8-b172-d12d508a9038",
    "templateId": "prebuilt-invoice"
  },
  "baseAnalyzerId": "prebuilt-document",
  "config": {
    "returnDetails": false,
    "enableOcr": true,
    "enableLayout": true,
    "enableFormula": true,
    "enableFigureDescription": false,
    "enableFigureAnalysis": false,
    "chartFormat": "chartjs",
    "tableFormat": "html",
    "enableSegment": false,
    "omitContent": false,
    "segmentPerPage": false,
    "annotationFormat": "markdown"
  },
  "fieldSchema": {
    "fields": {
      "Titular": {
        "type": "string",
        "method": "extract",
        "description": "Nombre completo del titular del recibo IBI. Extraer el nombre tal como aparece."
      },
      "NIF": {
        "type": "string",
        "method": "extract",
        "description": "NIF, DNI o NIE del titular del recibo IBI, Tasa de Basura, Vado, Plusvalia. Extraer solo el identificador."
      },
      "ImportePagado": {
        "type": "string",
        "method": "extract",
        "description": "Importe realmente pagado del recibo IBI, tasa de basura, plusvalia, vado o similar. Extraer el importe numérico."
      },
      "FechaPago": {
        "type": "string",
        "method": "extract",
        "description": "Fecha en que se realizó o realizará el pago del recibo. "
      },
      "FechaEmision": {
        "type": "string",
        "method": "extract",
        "description": "Fecha de emisión del recibo."
      },
      "TipoDocumento": {
        "type": "string",
        "method": "extract",
        "description": "Tipo de documento si aparece expresamente, por ejemplo 'CARTA DE PAGO', 'AVISO DE PAGO', 'RECIBO' o equivalente. Extraer exactamente como aparece. ",
        "estimateSourceAndConfidence": true
      },
      "ConceptoTributario": {
        "type": "string",
        "method": "extract",
        "description": "Concepto del tributo. Extraer el texto asociado a etiquetas como 'CONCEPTO', 'Concepto' o equivalentes, por ejemplo 'IMPUESTO BIENES INMUEBLES - URBANA', 'IBI-UR' o similar. No normalizar ni completar.",
        "estimateSourceAndConfidence": true
      },
      "Observaciones": {
        "type": "string",
        "method": "extract",
        "description": "Observaciones relevantes que aparezcan expresamente en el documento asociadas al pago, validez del recibo, periodo voluntario, vía ejecutiva o instrucciones tributarias. Extraer texto literal. No resumir ni interpretar.",
        "estimateSourceAndConfidence": true
      },
      "Emisor": {
        "type": "object",
        "method": "generate",
        "description": "Entidad que emite el escrito, a veces requerimiento de pago. Incluye el Nombre, Organo emisor y dirección. ",
        "properties": {
          "Nombre": {
            "type": "string",
            "method": "extract",
            "description": "Es el nombre del organismo emisor, puede ser un Ayuntamiento, Diputación, Ministerio o similar",
            "estimateSourceAndConfidence": true
          },
          "Dirección": {
            "type": "string",
            "method": "extract",
            "description": "Dirección postal del organismo emisor. Nunca poner Calle Costa Brava",
            "estimateSourceAndConfidence": true
          },
          "Organoemisor": {
            "type": "string",
            "method": "extract",
            "description": "Nombre completo del organo emisor o Unidad Gestora. Es la que emite el documento.",
            "estimateSourceAndConfidence": true
          }
        }
      },
      "FechaRecepcion": {
        "type": "string",
        "method": "extract",
        "description": "Fecha en la que se recibe el documento en Sareb. Aparece en el Sello Sareb, debajo del CIF",
        "estimateSourceAndConfidence": true
      },
      "ReciboVoluntario": {
        "type": "array",
        "method": "generate",
        "description": "Valores que se incluyen en el recibo para hacer posible su pago",
        "items": {
          "type": "object",
          "method": "generate",
          "properties": {
            "PeriodoPagoVoluntario": {
              "type": "string",
              "method": "extract",
              "description": "El periodo de pago, voluntario. Es un intervalo de entre dos fechas.",
              "estimateSourceAndConfidence": true
            },
            "Emisora": {
              "type": "string",
              "method": "extract",
              "description": "Codigo que corresponde al organo que emite el recibo",
              "estimateSourceAndConfidence": true
            },
            "Referencia": {
              "type": "string",
              "method": "extract",
              "description": "Numero incluido y permite el pago",
              "estimateSourceAndConfidence": true
            },
            "Identificador": {
              "type": "string",
              "method": "extract",
              "description": "Numero incluido en el recibo que permite el pago del recibo",
              "estimateSourceAndConfidence": true
            },
            "Periodo": {
              "type": "string",
              "method": "extract",
              "description": "Año y o mes al que corresponde el hecho imponible.",
              "estimateSourceAndConfidence": true
            },
            "ModeloMod": {
              "type": "string",
              "method": "extract",
              "description": "Numero de modelo si hay",
              "estimateSourceAndConfidence": true
            },
            "Importe": {
              "type": "string",
              "method": "extract",
              "description": "Importe a pagar en el periodo voluntario",
              "estimateSourceAndConfidence": true
            },
            "Recargo": {
              "type": "string",
              "method": "extract",
              "description": "Importe si lo hay",
              "estimateSourceAndConfidence": true
            },
            "Bonificacion": {
              "type": "string",
              "method": "extract",
              "description": "Importe que reduce el total",
              "estimateSourceAndConfidence": true
            },
            "NifEmisora": {
              "type": "string",
              "method": "extract",
              "description": "Numero de identificacion del emisor",
              "estimateSourceAndConfidence": true
            },
            "CPR": {
              "type": "string",
              "method": "extract",
              "description": "Numero incluido en alguno recibos",
              "estimateSourceAndConfidence": true
            },
            "NumeroRecibo": {
              "type": "string",
              "method": "extract",
              "description": "Numero del recibo",
              "estimateSourceAndConfidence": true
            }
          }
        }
      },
      "ReciboRecargo": {
        "type": "array",
        "method": "generate",
        "description": "Valores que se incluyen en el recibo para hacer posible su pago. En periodo con recargo",
        "items": {
          "type": "object",
          "method": "generate",
          "properties": {
            "PeriodoDePagoRecargo": {
              "type": "string",
              "method": "extract",
              "description": "El periodo de pago, con recargo. Es un intervalo de entre dos fechas.",
              "estimateSourceAndConfidence": true
            },
            "Emisora": {
              "type": "string",
              "method": "extract",
              "description": "Codigo que corresponde al organo que emite el recibo",
              "estimateSourceAndConfidence": true
            },
            "Referencia": {
              "type": "string",
              "method": "extract",
              "description": "Numero incluido y permite el pago",
              "estimateSourceAndConfidence": true
            },
            "Identificacion": {
              "type": "string",
              "method": "extract",
              "description": "Numero incluido en el recibo que permite el pago del recibo",
              "estimateSourceAndConfidence": true
            },
            "Periodo": {
              "type": "string",
              "method": "extract",
              "description": "Año y o mes al que corresponde el hecho imponible.",
              "estimateSourceAndConfidence": true
            },
            "ModeloMod": {
              "type": "string",
              "method": "extract",
              "description": "Numero de modelo si tiene",
              "estimateSourceAndConfidence": true
            },
            "Importe": {
              "type": "string",
              "method": "extract",
              "description": "Importe a pagar en el periodo con recago",
              "estimateSourceAndConfidence": true
            },
            "Recargo": {
              "type": "string",
              "method": "extract",
              "description": "Importe de recargo",
              "estimateSourceAndConfidence": true
            },
            "Bonificacion": {
              "type": "string",
              "method": "extract",
              "description": "Importe de bonificacion",
              "estimateSourceAndConfidence": true
            },
            "NifEmisora": {
              "type": "string",
              "method": "extract",
              "description": "Numero de identificación fiscal que emite el recibo",
              "estimateSourceAndConfidence": true
            },
            "CPR": {
              "type": "string",
              "method": "extract",
              "description": "Numero de identifacion del recibo",
              "estimateSourceAndConfidence": true
            },
            "NumeroRecibo": {
              "type": "string",
              "method": "extract",
              "description": "Numero del recibo",
              "estimateSourceAndConfidence": true
            }
          }
        }
      },
      "Calcula": {
        "type": "array",
        "method": "generate",
        "description": "Son todos los valores que llevan a calcular el pago del IBI",
        "items": {
          "type": "object",
          "method": "generate",
          "properties": {
            "CuotaTarifa": {
              "type": "string",
              "method": "extract",
              "description": "Importe inicial aplicar, suele se tambien Cuota Tarifa Anual",
              "estimateSourceAndConfidence": true
            },
            "CoefPonderacion": {
              "type": "string",
              "method": "extract",
              "description": "Coeficiente de Ponderacion",
              "estimateSourceAndConfidence": true
            },
            "CoefSItuacion": {
              "type": "string",
              "method": "extract",
              "description": "Coeficiente aplicado a la situación de inmueble",
              "estimateSourceAndConfidence": true
            },
            "CuotaPonderada": {
              "type": "string",
              "method": "extract",
              "description": "La Cuota ponderada es un importe ",
              "estimateSourceAndConfidence": true
            },
            "BonificacionesImperativas": {
              "type": "string",
              "method": "extract",
              "description": "Bonificaciones Imperativas",
              "estimateSourceAndConfidence": true
            },
            "BonificacionesPotestativas": {
              "type": "string",
              "method": "extract",
              "description": "Bonificaciones Potestativas",
              "estimateSourceAndConfidence": true
            },
            "CuotaLiquida": {
              "type": "string",
              "method": "extract",
              "description": "Cuota Liquida Municipal o similar",
              "estimateSourceAndConfidence": true
            },
            "RecargoProvincial": {
              "type": "string",
              "method": "extract",
              "description": "Importe habitual, se suele aplicar el 30%, poner valor número asociado al campo",
              "estimateSourceAndConfidence": true
            },
            "DeudaLiquidaTotal": {
              "type": "string",
              "method": "extract",
              "description": "Es el importe que normalmente corresponde al importe a pagar",
              "estimateSourceAndConfidence": true
            },
            "Referencia": {
              "type": "string",
              "method": "extract",
              "description": "Suele ser la Referencia Censal",
              "estimateSourceAndConfidence": true
            },
            "Trimestres": {
              "type": "string",
              "method": "extract",
              "description": "Numero de trimestres",
              "estimateSourceAndConfidence": true
            }
          }
        }
      },
      "Resumen": {
        "type": "array",
        "method": "generate",
        "description": "Resume todos los campos necesarios para la elaboración. Se encuentran ya indicados en el recibo",
        "items": {
          "type": "object",
          "method": "generate",
          "properties": {
            "FechaEntrada": {
              "type": "string",
              "method": "extract",
              "description": "Fecha de recepción del documento, electrónicamente o en estafeta. Si es electrónico será la fecha de gestión de entrada",
              "estimateSourceAndConfidence": true
            },
            "CanalEntrada": {
              "type": "string",
              "method": "extract",
              "description": "Será digital o estafeta. Si es estafeta siempre lleva sello",
              "estimateSourceAndConfidence": true
            },
            "OrganismoEmisor": {
              "type": "string",
              "method": "extract",
              "description": "Organismo que emite el tributo",
              "estimateSourceAndConfidence": true
            },
            "Municipio": {
              "type": "string",
              "method": "extract",
              "description": "Municipio donde se encuentra el activo",
              "estimateSourceAndConfidence": true
            },
            "ReferenciaCatastral": {
              "type": "array",
              "method": "generate",
              "description": "Referencia Catastral, si no es exacto NO Poner nada",
              "items": {
                "type": "string",
                "method": "extract",
                "estimateSourceAndConfidence": true
              }
            },
            "Dirección": {
              "type": "array",
              "method": "generate",
              "description": "Dirección, bien inmueble, hecho imponible u objeto tributario sujeto a la TASA DE BASURA.  IBI,  PLUSVALIA, VADO Extraer únicamente el texto que aparezca junto a etiquetas como 'OBJ. TRIB', 'Objeto tributario', 'OBXECTO TRIBUTARIO', 'DIRECCION TRIBUTARIA', 'BIEN INMUEBLE', 'HECHO IMPONIBLE' u otras equivalentes.   Nunca Poner Calle Costa Brava",
              "items": {
                "type": "string",
                "method": "extract",
                "estimateSourceAndConfidence": true
              },
              "estimateSourceAndConfidence": true
            },
            "Naturaleza": {
              "type": "string",
              "method": "extract",
              "description": "Concepto del tributo. Extraer el texto asociado a etiquetas como 'CONCEPTO', 'Concepto' o equivalentes, por ejemplo 'IMPUESTO BIENES INMUEBLES - URBANA', 'IBI-UR' o similar. No normalizar ni completar.",
              "estimateSourceAndConfidence": true
            },
            "Año": {
              "type": "string",
              "method": "extract",
              "description": "Año en el que se liquida el tributo",
              "estimateSourceAndConfidence": true
            },
            "Identificador": {
              "type": "string",
              "method": "extract",
              "description": "Identificador del Documento",
              "estimateSourceAndConfidence": true
            },
            "FechaVencimiento": {
              "type": "string",
              "method": "extract",
              "description": "Ultima fecha de pago del tributo",
              "estimateSourceAndConfidence": true
            }
          }
        }
      }
    }
  },
