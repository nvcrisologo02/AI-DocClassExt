@page "/monitor/{Guid}"
@inject MonitorService MonitorService
@rendermode InteractiveServer

<PageTitle>Detalle de ejecución</PageTitle>

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/monitor" class="btn btn-sm btn-outline-secondary">← Volver al monitor</a>
    <h1 class="h4 mb-0">Detalle de ejecución</h1>
</div>

@if (_cargando)
{
    <div class="text-muted">Cargando…</div>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_detalle is null)
{
    <div class="alert alert-warning">
        No existe ninguna ejecución con el identificador <code>@Guid</code>.
    </div>
}
else
{
    <div class="card"><div class="card-body">
        <EjecucionDetalle Detalle="_detalle" />
    </div></div>
}

@code {
    [Parameter] public string Guid { get; set; } = string.Empty;

    private EjecucionDetalleDto? _detalle;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            _detalle = await MonitorService.GetEjecucionDetalleAsync(Guid);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }
}
