@page "/monitor"
@page "/monitor/{Guid}"
@inject MonitorService MonitorService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Monitor de Ejecuciones</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">Monitor de Ejecuciones</h1>
    <div class="d-flex align-items-center gap-2">
        <label class="text-muted small mb-0">Auto-actualizar</label>
        <select class="form-select form-select-sm" style="width:auto" value="@_intervaloAutoRefrescoSegundos" @onchange="OnIntervaloAutoRefrescoCambiado">
            <option value="0">Off</option>
            <option value="30">30 s</option>
            <option value="60">60 s</option>
        </select>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RecargarTodoAsync" disabled="@_cargando">
            Actualizar
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <div>
                <h6 class="mb-0">Salud del sistema</h6>
                <small class="text-muted">Estado de componentes backend</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (_loadingSystemHealth)
                {
                    <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
                }
                @if (_systemHealth != null)
                {
                    <span class="badge @HealthBadgeClass(_systemHealth.Status)">@_systemHealth.Status</span>
                    <small class="text-muted">@HoraEspana.Formatear(_systemHealth.Timestamp, "HH:mm:ss")</small>
                }
                else
                {
                    <span class="badge bg-secondary">sin datos</span>
                }
            </div>
        </div>

        @if (_systemHealth != null)
        {
            <div class="row g-2" style="font-size:0.85rem">
                <div class="col-12 col-md-6 col-lg-4">
                    <div><span class="badge @HealthBadgeClass(_systemHealth.Components.Functions.Status)">functions</span> @_systemHealth.Components.Functions.Message</div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <div><span class="badge @HealthBadgeClass(_systemHealth.Components.AssetResolver.Status)">assetResolver</span> @_systemHealth.Components.AssetResolver.Message</div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <div><span class="badge @HealthBadgeClass(_systemHealth.Components.Gdc.Status)">gdc</span> @_systemHealth.Components.Gdc.Message</div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <div><span class="badge @HealthBadgeClass(_systemHealth.Components.ModelProviders.Status)">modelProviders</span> @_systemHealth.Components.ModelProviders.Status</div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <div><span class="badge @HealthBadgeClass(_systemHealth.Components.ModelProviders.Classification.Status)">classification</span> @_systemHealth.Components.ModelProviders.Classification.Message</div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <div><span class="badge @HealthBadgeClass(_systemHealth.Components.ModelProviders.Extraction.Status)">extraction</span> @_systemHealth.Components.ModelProviders.Extraction.Message</div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                    <div><span class="badge @HealthBadgeClass(_systemHealth.Components.ModelProviders.Prompt.Status)">prompt</span> @_systemHealth.Components.ModelProviders.Prompt.Message</div>
                </div>
            </div>
        }
    </div>
</div>

<MonitorFiltros Filtro="_filtro" Tipologias="_tipologias" FiltroCambiado="OnFiltroCambiado" />

<MonitorKpis Agregados="_agregados" Cargando="_cargando" />

<MonitorGraficos Serie="_agregados?.Serie ?? []" />

@if (_agregados is not null && (_agregados.PorTipologia.Count > 0 || _agregados.PorModelo.Count > 0))
{
    <div class="card shadow-sm mb-4">
        <div class="card-header py-2">
            <span class="fw-semibold">Desglose por tipología y modelo</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small fw-semibold text-uppercase mb-2" style="font-size:0.72rem;letter-spacing:0.05em">Por tipología</div>
                    @if (_agregados.PorTipologia.Count > 0)
                    {
                        <div style="max-height:260px;overflow-y:auto">
                            <table class="table table-sm table-hover mb-0" style="font-size:0.82rem">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tipología</th>
                                        <th class="text-end">Total</th>
                                        <th style="min-width:90px">OK / Rev / Err</th>
                                        <th class="text-end">Conf.</th>
                                        <th class="text-end">Dur. media</th>
                                        <th class="text-center">FB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grupo in _agregados.PorTipologia)
                                    {
                                        var pctOk = grupo.Total > 0 ? (int)Math.Round(100.0 * grupo.Ok / grupo.Total) : 0;
                                        var pctRev = grupo.Total > 0 ? (int)Math.Round(100.0 * grupo.Revision / grupo.Total) : 0;
                                        var pctErr = grupo.Total > 0 ? (int)Math.Round(100.0 * grupo.Error / grupo.Total) : 0;
                                        <tr>
                                            <td class="text-truncate" style="max-width:140px" title="@grupo.Grupo">@grupo.Grupo</td>
                                            <td class="text-end fw-semibold">@grupo.Total</td>
                                            <td>
                                                <div class="d-flex rounded overflow-hidden" style="height:10px;background:#e9ecef">
                                                    @if (pctOk > 0) { <div class="bg-success" style="width:@(pctOk)%" title="@grupo.Ok OK"></div> }
                                                    @if (pctRev > 0) { <div class="bg-warning" style="width:@(pctRev)%" title="@grupo.Revision Rev."></div> }
                                                    @if (pctErr > 0) { <div class="bg-danger" style="width:@(pctErr)%" title="@grupo.Error Err."></div> }
                                                </div>
                                                <div class="d-flex gap-1 mt-1" style="font-size:0.7rem">
                                                    @if (grupo.Ok > 0) { <span class="text-success">@grupo.Ok</span> }
                                                    @if (grupo.Revision > 0) { <span class="text-warning">@grupo.Revision</span> }
                                                    @if (grupo.Error > 0) { <span class="text-danger">@grupo.Error</span> }
                                                </div>
                                            </td>
                                            <td class="text-end @ConfianzaClass(grupo.ConfianzaMedia)">@(grupo.ConfianzaMedia > 0 ? grupo.ConfianzaMedia.ToString("P0") : "—")</td>
                                            <td class="text-end text-nowrap">@FormatDuracion((int)grupo.DuracionMediaMs)</td>
                                            <td class="text-center">
                                                @if (grupo.Fallbacks > 0)
                                                {
                                                    <span class="badge bg-warning text-dark" style="font-size:0.65rem">@grupo.Fallbacks</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">Sin datos en el período</span>
                    }
                </div>

                <div class="col-md-6">
                    <div class="text-muted small fw-semibold text-uppercase mb-2" style="font-size:0.72rem;letter-spacing:0.05em">Por modelo</div>
                    @if (_agregados.PorModelo.Count > 0)
                    {
                        <div style="max-height:260px;overflow-y:auto">
                            <table class="table table-sm table-hover mb-0" style="font-size:0.82rem">
                                <thead class="table-light">
                                    <tr>
                                        <th>Modelo</th>
                                        <th class="text-end">Total</th>
                                        <th style="min-width:90px">OK / Rev / Err</th>
                                        <th class="text-end">Conf.</th>
                                        <th class="text-end">Dur. media</th>
                                        <th class="text-center">FB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grupo in _agregados.PorModelo)
                                    {
                                        var pctOk = grupo.Total > 0 ? (int)Math.Round(100.0 * grupo.Ok / grupo.Total) : 0;
                                        var pctRev = grupo.Total > 0 ? (int)Math.Round(100.0 * grupo.Revision / grupo.Total) : 0;
                                        var pctErr = grupo.Total > 0 ? (int)Math.Round(100.0 * grupo.Error / grupo.Total) : 0;
                                        <tr>
                                            <td class="text-truncate" style="max-width:140px" title="@grupo.Grupo">@grupo.Grupo</td>
                                            <td class="text-end fw-semibold">@grupo.Total</td>
                                            <td>
                                                <div class="d-flex rounded overflow-hidden" style="height:10px;background:#e9ecef">
                                                    @if (pctOk > 0) { <div class="bg-success" style="width:@(pctOk)%" title="@grupo.Ok OK"></div> }
                                                    @if (pctRev > 0) { <div class="bg-warning" style="width:@(pctRev)%" title="@grupo.Revision Rev."></div> }
                                                    @if (pctErr > 0) { <div class="bg-danger" style="width:@(pctErr)%" title="@grupo.Error Err."></div> }
                                                </div>
                                                <div class="d-flex gap-1 mt-1" style="font-size:0.7rem">
                                                    @if (grupo.Ok > 0) { <span class="text-success">@grupo.Ok</span> }
                                                    @if (grupo.Revision > 0) { <span class="text-warning">@grupo.Revision</span> }
                                                    @if (grupo.Error > 0) { <span class="text-danger">@grupo.Error</span> }
                                                </div>
                                            </td>
                                            <td class="text-end @ConfianzaClass(grupo.ConfianzaMedia)">@(grupo.ConfianzaMedia > 0 ? grupo.ConfianzaMedia.ToString("P0") : "—")</td>
                                            <td class="text-end text-nowrap">@FormatDuracion((int)grupo.DuracionMediaMs)</td>
                                            <td class="text-center">
                                                @if (grupo.Fallbacks > 0)
                                                {
                                                    <span class="badge bg-warning text-dark" style="font-size:0.65rem">@grupo.Fallbacks</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted small">Sin datos en el período</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

<MonitorTabla Pagina="_pagina" Cargando="_cargando"
              PaginaCambiada="OnPaginaCambiada"
              TamanoPagina="_tamanoPagina" TamanoPaginaCambiado="OnTamanoPaginaCambiado"
              Expandidos="_expandidos" Detalles="_detalles" CargandoDetalle="_cargandoDetalle"
              FilaAlternada="OnFilaAlternadaAsync" AbrirDetalle="AbrirModal" />

@if (_modalGuid is not null)
{
    <EjecucionJsonModal Guid="@_modalGuid"
                         Detalle="_detalles.GetValueOrDefault(_modalGuid)"
                         Cargando="_modalCargando"
                         NoEncontrado="_guidsNoEncontrados.Contains(_modalGuid)"
                         ErrorMensaje="@_modalError"
                         OnCerrar="CerrarModal" />
}

@code {
    // Ruta opcional /monitor/{Guid}: mantiene el detalle enlazable (AB#99968)
    // sin la pagina propia que existia antes; ver AbrirModal/CerrarModal y
    // OnParametersSetAsync mas abajo.
    [Parameter] public string? Guid { get; set; }

    private MonitorFiltroDto _filtro = new();
    private PagedResultDto<EjecucionResumenDto>? _pagina;
    private DashboardAgregadosDto? _agregados;
    private IReadOnlyList<string> _tipologias = [];
    // Estado de expansion de la tabla: que filas estan abiertas y el detalle ya
    // cargado por GUID, para no repetir la peticion al volver a expandir la
    // misma fila.
    private readonly HashSet<string> _expandidos = [];
    private readonly Dictionary<string, EjecucionDetalleDto> _detalles = new();
    private readonly HashSet<string> _cargandoDetalle = [];
    private int _paginaActual = 1;
    private int _tamanoPagina = 25;
    private bool _cargando;
    private string? _error;
    private SystemHealthDto? _systemHealth;
    private bool _loadingSystemHealth;
    private Timer? _timer;
    private bool _disposed;
    private int _intervaloAutoRefrescoSegundos = 30;

    // Estado del modal de detalle JSON. _modalGuid nulo significa cerrado.
    // Comparte cache de detalle (_detalles) con la fila desplegable: si el
    // usuario ya expandio la fila, abrir el modal no repite la peticion.
    private string? _modalGuid;
    private bool _modalCargando;
    private string? _modalError;
    private readonly HashSet<string> _guidsNoEncontrados = [];

    protected override async Task OnInitializedAsync()
    {
        var tareaTipologias = CargarTipologiasAsync();
        await RecargarTodoAsync();
        await tareaTipologias;
        StartTimer();
    }

    // Se ejecuta tras OnInitializedAsync en la primera carga y de nuevo cada
    // vez que AbrirModal/CerrarModal cambian la URL: al navegar entre
    // /monitor y /monitor/{guid} el router reutiliza esta misma instancia de
    // componente (mismo tipo de pagina en las dos rutas), asi que
    // OnInitializedAsync no se repite y todo el ciclo de apertura/cierre del
    // modal vive aqui.
    protected override async Task OnParametersSetAsync()
    {
        var guidRuta = string.IsNullOrWhiteSpace(Guid) ? null : Guid;
        if (guidRuta == _modalGuid) return;

        _modalGuid = guidRuta;
        _modalError = null;
        if (guidRuta is null) return;

        if (_detalles.ContainsKey(guidRuta) || _guidsNoEncontrados.Contains(guidRuta)) return;

        _modalCargando = true;
        try
        {
            var detalle = await MonitorService.GetEjecucionDetalleAsync(guidRuta);
            if (detalle is not null)
            {
                _detalles[guidRuta] = detalle;
            }
            else
            {
                _guidsNoEncontrados.Add(guidRuta);
            }
        }
        catch (InvalidOperationException ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _modalCargando = false;
        }
    }

    // Navegar en vez de asignar el estado directamente es lo que mantiene la
    // URL sincronizada (AB#99968): el cambio de ruta dispara OnParametersSetAsync,
    // que es el unico sitio que toca _modalGuid.
    private void AbrirModal(string guid) => Navigation.NavigateTo($"/monitor/{guid}", replace: false);

    // replace: true evita que el cierre deje entrada propia en el historial del
    // navegador; sin esto, abrir y cerrar el modal hacia que el boton Atras lo
    // volviera a abrir en vez de salir de /monitor (AB#99968).
    private void CerrarModal() => Navigation.NavigateTo("/monitor", replace: true);

    // El catalogo del desplegable se carga una unica vez, con un filtro propio
    // que ignora tipologia, periodo y el resto de dimensiones. Si se recalculara
    // a partir de _agregados (que sí respeta el filtro activo), elegir una
    // tipologia recortaria la propia consulta y el desplegable perderia el resto
    // de opciones. Cargarlo aparte tambien evita repetir esta peticion en cada
    // refresco, a diferencia de clonar el filtro activo con Tipologia = null.
    private async Task CargarTipologiasAsync()
    {
        var catalogo = await MonitorService.GetAgregadosAsync(FiltroCatalogoTipologias());
        if (catalogo is null) return;

        _tipologias = catalogo.PorTipologia
            .Select(g => g.Grupo)
            .Where(g => !string.IsNullOrWhiteSpace(g) && g != "(sin tipología)")
            .OrderBy(g => g)
            .ToList();
    }

    private static MonitorFiltroDto FiltroCatalogoTipologias() => new()
    {
        RangoDias = MonitorFiltroDto.RangoDiasHistorico
    };

    // Al cambiar el filtro se recargan agregados y primera pagina. Al cambiar de
    // pagina solo se pide la pagina: los agregados no dependen de ella.
    private async Task OnFiltroCambiado(MonitorFiltroDto nuevo)
    {
        _filtro = nuevo;
        _paginaActual = 1;
        ColapsarFilas();
        await RecargarTodoAsync();
    }

    private async Task OnPaginaCambiada(int pagina)
    {
        _paginaActual = pagina;
        ColapsarFilas();
        await RecargarPaginaAsync();
    }

    // Cambiar el tamaño vuelve a la primera pagina: mantener el numero de pagina
    // actual con un tamaño distinto apuntaria a un tramo arbitrario del listado
    // (la pagina 4 de 25 en no es la pagina 4 de 100 en).
    private async Task OnTamanoPaginaCambiado(int tamano)
    {
        _tamanoPagina = tamano;
        _paginaActual = 1;
        ColapsarFilas();
        await RecargarPaginaAsync();
    }

    // Al cambiar de filtro o pagina las filas expandidas dejan de tener sentido
    // (la fila ya no esta en pantalla); se colapsan para no arrastrar detalle
    // cargado de una fila que ya no se ve.
    private void ColapsarFilas()
    {
        _expandidos.Clear();
        _cargandoDetalle.Clear();
    }

    private async Task RecargarTodoAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            var tareaAgregados = MonitorService.GetAgregadosAsync(_filtro);
            var tareaPagina = MonitorService.GetEjecucionesAsync(_filtro, _paginaActual, _tamanoPagina);
            var tareaSalud = LoadSystemHealthAsync();
            await Task.WhenAll(tareaAgregados, tareaPagina, tareaSalud);

            _agregados = await tareaAgregados;
            _pagina = await tareaPagina;
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task RecargarPaginaAsync()
    {
        _cargando = true;
        try
        {
            _pagina = await MonitorService.GetEjecucionesAsync(_filtro, _paginaActual, _tamanoPagina);
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task LoadSystemHealthAsync()
    {
        _loadingSystemHealth = true;
        try
        {
            _systemHealth = await MonitorService.GetSystemHealthAsync();
        }
        finally
        {
            _loadingSystemHealth = false;
        }
    }

    private void StartTimer()
    {
        if (_intervaloAutoRefrescoSegundos <= 0) return;
        var intervalo = TimeSpan.FromSeconds(_intervaloAutoRefrescoSegundos);
        _timer = new Timer(OnAutoRefrescoTick, null, intervalo, intervalo);
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
    }

    // Cambiar el intervalo no debe recargar la pagina ni tocar el filtro
    // seleccionado: solo reprograma el temporizador con el nuevo periodo (o lo
    // detiene si se elige "Off").
    private void OnIntervaloAutoRefrescoCambiado(ChangeEventArgs e)
    {
        _intervaloAutoRefrescoSegundos = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        StopTimer();
        StartTimer();
    }

    // El callback del Timer corre en un hilo del pool, fuera del contexto de
    // sincronizacion de Blazor: InvokeAsync lo devuelve a ese contexto antes de
    // tocar el estado del componente. _disposed evita reentrar tras el Dispose
    // (navegacion fuera de la pagina) y ObjectDisposedException se captura porque
    // en ese caso no queda nada que actualizar; dejarla sin capturar tumbaria el
    // circuito completo, no solo este refresco. _cargando evita solapar este
    // refresco automatico con otro ya en curso (manual o automatico).
    private void OnAutoRefrescoTick(object? state)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _cargando) return;
            try
            {
                await RecargarTodoAsync();
                StateHasChanged();
            }
            catch (ObjectDisposedException)
            {
            }
            // A diferencia de una accion del usuario, este refresco no tiene a quien
            // devolverle el fallo: lo que escape de aqui llega al dispatcher del
            // circuito y lo termina, tirando la pagina entera por un refresco
            // fallido. Se deja constancia visible y se sigue con el siguiente ciclo,
            // que puede volver a funcionar si el fallo era transitorio.
            catch (Exception ex)
            {
                _error = $"Fallo en la actualizacion automatica: {ex.Message}";
                StateHasChanged();
            }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        StopTimer();
    }

    // Alterna la fila: si estaba expandida se colapsa sin volver a pedir nada;
    // si se expande y el detalle no esta en cache todavia se pide bajo demanda.
    private async Task OnFilaAlternadaAsync(string guid)
    {
        if (!_expandidos.Add(guid))
        {
            _expandidos.Remove(guid);
            return;
        }

        if (_detalles.ContainsKey(guid)) return;

        _cargandoDetalle.Add(guid);
        try
        {
            var detalle = await MonitorService.GetEjecucionDetalleAsync(guid);
            if (detalle is not null)
            {
                _detalles[guid] = detalle;
            }
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargandoDetalle.Remove(guid);
        }
    }

    private static string HealthBadgeClass(string? status) => status?.ToLowerInvariant() switch
    {
        "healthy" => "bg-success",
        "degraded" => "bg-warning text-dark",
        "unhealthy" => "bg-danger",
        "unconfigured" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string ConfianzaClass(double c) => c switch
    {
        >= 0.7 => "text-success fw-semibold",
        >= 0.5 => "text-warning fw-semibold",
        > 0 => "text-danger fw-semibold",
        _ => "text-muted"
    };

    private static string FormatDuracion(int ms)
    {
        if (ms < 1000) return $"{ms} ms";
        if (ms < 60000) return $"{ms / 1000.0:F1} s";
        return $"{ms / 60000}m {(ms % 60000) / 1000}s";
    }
}
