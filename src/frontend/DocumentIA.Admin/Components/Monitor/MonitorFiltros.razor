@implements IDisposable

<div class="card mb-3"><div class="card-body">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-lg-3">
            <label class="form-label small text-muted mb-1">Rango</label>
            <select class="form-select" value="@ValorRango" @onchange="OnRangoCambiado">
                <option value="1">Últimas 24 horas</option>
                <option value="7">Últimos 7 días</option>
                <option value="30">Últimos 30 días</option>
                <option value="90">Últimos 90 días</option>
                <option value="@RangoPersonalizado">Personalizado</option>
            </select>
        </div>
        @* AB#100284: periodo cerrado en dias de calendario peninsular, ambos inclusive.
           Las fechas solo se muestran en modo Personalizado; mientras falte una de
           las dos el filtro sigue usando la ventana relativa. *@
        @if (_personalizado)
        {
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1">Desde</label>
            <input type="date" class="form-control" value="@Fecha(Filtro.Desde)" @onchange="OnDesdeCambiado" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1">Hasta</label>
            <input type="date" class="form-control" value="@Fecha(Filtro.Hasta)" @onchange="OnHastaCambiado" />
        </div>
        }
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1">Tipología</label>
            <select class="form-select" value="@Filtro.Tipologia" @onchange="OnTipologiaCambiada">
                <option value="">Todas</option>
                @foreach (var t in Tipologias)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1">Estado</label>
            <select class="form-select" value="@Filtro.Estado" @onchange="OnEstadoCambiado">
                <option value="">Todos</option>
                <option value="OK">Correctas</option>
                <option value="REVISION">En revisión</option>
                <option value="ERROR">Con error</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1">Flujo</label>
            <select class="form-select" value="@Filtro.Flujo" @onchange="OnFlujoCambiado">
                <option value="">Todos</option>
                <option value="Clasificacion">Clasificación</option>
                <option value="Completo">Completo</option>
            </select>
        </div>
        @* AB#100258: por defecto se excluyen, que es el conjunto que ha descrito
           siempre el Monitor. Una reutilizacion no reprocesa nada. *@
        @if (MostrarReutilizaciones)
        {
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1">Reutilizaciones</label>
            <select class="form-select" value="@Filtro.Reutilizadas" @onchange="OnReutilizadasCambiado">
                <option value="">Excluir</option>
                <option value="incluir">Incluir</option>
                <option value="solo">Solo reutilizaciones</option>
            </select>
        </div>
        }
        <div class="col-12 col-lg-3">
            <label class="form-label small text-muted mb-1">Buscar</label>
            <input class="form-control" placeholder="GUID exacto o nombre de documento"
                   value="@Filtro.Busqueda" @oninput="OnBusquedaCambiada" />
        </div>
        <div class="col-12 col-lg-3">
            <label class="form-label small text-muted mb-1">Solicitado por</label>
            <input class="form-control" placeholder="Fragmento del solicitante"
                   value="@Filtro.SubmittedBy" @oninput="OnSolicitanteCambiado" />
        </div>
    </div>
</div></div>

@code {
    [Parameter, EditorRequired] public MonitorFiltroDto Filtro { get; set; } = new();
    [Parameter] public IReadOnlyList<string> Tipologias { get; set; } = [];
    [Parameter] public EventCallback<MonitorFiltroDto> FiltroCambiado { get; set; }

    /// <summary>
    /// La pagina de costes no sabe calcular el ahorro de las reutilizaciones, asi que
    /// alli "Solo reutilizaciones" solo produciria un panel a cero sin explicacion.
    /// </summary>
    [Parameter] public bool MostrarReutilizaciones { get; set; } = true;

    // Cada campo con retardo tiene su propio Timer: compartir uno solo entre
    // busqueda y solicitante haria que escribir en uno cancelara el retardo
    // pendiente del otro.
    private Timer? _debounceBusqueda;
    private Timer? _debounceSolicitante;
    private bool _disposed;

    private const string RangoPersonalizado = "custom";

    // El modo se recuerda aparte del filtro: al borrar una fecha el filtro deja de
    // ser fijo, pero los inputs deben seguir a la vista para poder completarla.
    private bool _personalizado;

    protected override void OnParametersSet()
    {
        if (Filtro.EsRangoFijo) _personalizado = true;
    }

    private string ValorRango => _personalizado ? RangoPersonalizado : Filtro.RangoDias.ToString();

    private static string? Fecha(DateOnly? dia) => dia?.ToString("yyyy-MM-dd");

    // El rango relativo es la anchura de la ventana, no sus extremos: los calcula el
    // propio filtro en cada consulta para que el auto-refresco siga viendo lo mas
    // reciente. El personalizado es lo contrario: un periodo cerrado, precargado con
    // el mes en curso porque el caso tipico es sacar el coste de un mes natural.
    private async Task OnRangoCambiado(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        if (valor == RangoPersonalizado)
        {
            _personalizado = true;
            var hoy = DateOnly.FromDateTime(HoraEspana.Desde(DateTime.UtcNow));
            await Emitir(f =>
            {
                f.Desde = new DateOnly(hoy.Year, hoy.Month, 1);
                f.Hasta = hoy;
            });
            return;
        }

        _personalizado = false;
        await Emitir(f =>
        {
            f.RangoDias = int.TryParse(valor, out var d) ? d : 7;
            f.Desde = null;
            f.Hasta = null;
        });
    }

    private async Task OnDesdeCambiado(ChangeEventArgs e) => await Emitir(f => f.Desde = FechaDe(e));
    private async Task OnHastaCambiado(ChangeEventArgs e) => await Emitir(f => f.Hasta = FechaDe(e));

    // El input nativo entrega yyyy-MM-dd o cadena vacia si el usuario borra la fecha.
    private static DateOnly? FechaDe(ChangeEventArgs e) =>
        DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", out var dia) ? dia : null;

    private async Task OnTipologiaCambiada(ChangeEventArgs e) => await Emitir(f => f.Tipologia = Texto(e));
    private async Task OnEstadoCambiado(ChangeEventArgs e) => await Emitir(f => f.Estado = Texto(e));
    private async Task OnFlujoCambiado(ChangeEventArgs e) => await Emitir(f => f.Flujo = Texto(e));
    private async Task OnReutilizadasCambiado(ChangeEventArgs e) => await Emitir(f => f.Reutilizadas = Texto(e));

    // La busqueda se retrasa para no lanzar una consulta por pulsacion. El
    // callback del Timer corre en un hilo del pool, fuera del contexto de
    // sincronizacion de Blazor: InvokeAsync lo devuelve a ese contexto antes
    // de tocar el estado del componente. Si el componente ya se elimino
    // (navegacion fuera de la pagina) mientras el retardo estaba pendiente,
    // InvokeAsync puede fallar; se ignora porque no queda nada que actualizar
    // y una excepcion sin capturar aqui (metodo "async void" del Timer)
    // terminaria el circuito completo, no solo esta actualizacion.
    private void OnBusquedaCambiada(ChangeEventArgs e)
    {
        var texto = Texto(e);
        _debounceBusqueda?.Dispose();
        _debounceBusqueda = new Timer(async _ =>
        {
            if (_disposed) return;
            try
            {
                await InvokeAsync(async () => await Emitir(f => f.Busqueda = texto));
            }
            catch (ObjectDisposedException)
            {
            }
            // Este delegado es "async void": lo que escape de aqui no lo recoge
            // nadie y termina el proceso, no solo la pagina. El consumidor del
            // evento ya muestra los fallos esperados; lo que llegue hasta aqui no
            // tiene ya forma de reportarse sin tirar el servidor.
            catch (Exception)
            {
            }
        }, null, 300, Timeout.Infinite);
    }

    private void OnSolicitanteCambiado(ChangeEventArgs e)
    {
        var texto = Texto(e);
        _debounceSolicitante?.Dispose();
        _debounceSolicitante = new Timer(async _ =>
        {
            if (_disposed) return;
            try
            {
                await InvokeAsync(async () => await Emitir(f => f.SubmittedBy = texto));
            }
            catch (ObjectDisposedException)
            {
            }
            // Mismo motivo que en la busqueda: delegado "async void".
            catch (Exception)
            {
            }
        }, null, 300, Timeout.Infinite);
    }

    private async Task Emitir(Action<MonitorFiltroDto> cambio)
    {
        var nuevo = Filtro.Clonar();
        cambio(nuevo);
        await FiltroCambiado.InvokeAsync(nuevo);
    }

    private static string? Texto(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        return string.IsNullOrWhiteSpace(v) ? null : v;
    }

    public void Dispose()
    {
        _disposed = true;
        _debounceBusqueda?.Dispose();
        _debounceSolicitante?.Dispose();
    }
}
