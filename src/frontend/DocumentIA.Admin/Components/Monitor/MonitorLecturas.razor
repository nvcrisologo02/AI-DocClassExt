@using System.Globalization
@* Las dos lecturas del mismo conjunto, lado a lado: que hizo el proceso y cuanta
   confianza merece el resultado. Presentarlas juntas es lo que evita volver a
   confundirlas, que es el origen del contador "En revisión" que siempre valia
   cero. Cada tramo navega al listado con ese recorte y lleva su recuento como
   texto, para que naranja y rojo no se distingan solo por el color. *@

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="mb-0">Resultado del proceso</h6>
                <small class="text-muted d-block mb-3">¿Terminó la tubería?</small>
                @if (Proceso.Count == 0)
                {
                    <span class="text-muted small">Sin datos en el período</span>
                }
                else
                {
                    <div class="d-flex mb-2" style="height:22px;gap:2px">
                        @foreach (var g in Proceso)
                        {
                            <button type="button" class="btn p-0 border-0 sareb-tramo"
                                    style="width:@Ancho(g.Total, TotalProceso)%;background:@ColorProceso(g.Grupo)"
                                    title="@g.Grupo: @g.Total"
                                    @onclick="() => EstadoSeleccionado.InvokeAsync(g.Grupo)">@g.Total</button>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-3" style="font-size:0.75rem">
                        @foreach (var g in Proceso)
                        {
                            <span>
                                <span class="d-inline-block rounded" style="width:9px;height:9px;background:@ColorProceso(g.Grupo)"></span>
                                @g.Grupo <span class="fw-semibold">@g.Total</span>
                                <span class="text-muted">@Porcentaje(g.Total, TotalProceso)</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h6 class="mb-0">Calidad por confianza</h6>
                <small class="text-muted d-block mb-3">¿Merece confianza el resultado?</small>
                @if (TotalCalidad == 0)
                {
                    <span class="text-muted small">Sin datos en el período</span>
                }
                else
                {
                    <div class="d-flex mb-2" style="height:22px;gap:2px">
                        @foreach (var c in Calidades)
                        {
                            <button type="button" class="btn p-0 border-0 sareb-tramo"
                                    style="width:@Ancho(c.Total, TotalCalidad)%;background:@c.Color"
                                    title="@c.Etiqueta: @c.Total"
                                    @onclick="() => CalidadSeleccionada.InvokeAsync(c.Clave)">@c.Total</button>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-3" style="font-size:0.75rem">
                        @foreach (var c in Calidades)
                        {
                            <span>
                                <span class="d-inline-block rounded" style="width:9px;height:9px;background:@c.Color"></span>
                                @c.Etiqueta <span class="fw-semibold">@c.Total</span>
                                <span class="text-muted">@Porcentaje(c.Total, TotalCalidad)</span>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<AgregadoGrupoDto> Proceso { get; set; } = [];
    [Parameter] public int CalidadOk { get; set; }
    [Parameter] public int CalidadRevision { get; set; }
    [Parameter] public int CalidadError { get; set; }
    [Parameter] public EventCallback<string> EstadoSeleccionado { get; set; }
    [Parameter] public EventCallback<string> CalidadSeleccionada { get; set; }

    private record Tramo(string Clave, string Etiqueta, int Total, string Color);

    private int TotalProceso => Proceso.Sum(g => g.Total);
    private int TotalCalidad => CalidadOk + CalidadRevision + CalidadError;

    private List<Tramo> Calidades =>
    [
        new("OK", "Suficiente", CalidadOk, SarebPaleta.Ok),
        new("REVISION", "Requiere revisión", CalidadRevision, SarebPaleta.Revision),
        new("ERROR", "Insuficiente", CalidadError, SarebPaleta.Error)
    ];

    // Verde solo para el estado que representa "termino sin incidencias"; el
    // resto se distingue por gravedad. Cualquier estado no previsto cae en gris
    // en vez de heredar un color que insinue algo que no sabemos.
    private static string ColorProceso(string estado) => estado switch
    {
        "OK" or "Completado" or "Completed" => SarebPaleta.Ok,
        "VALIDACION_CON_ERRORES" or "EXTRACCION_INCOMPLETA" => SarebPaleta.Error,
        "Error" or "ERROR" or "Fallido" or "PAGINAS_EXCEDIDAS" or "SIN_CONTENIDO_DOCUMENTO" => SarebPaleta.Error,
        "NO_CLASIFICADO" or "BAJA_CONFIANZA_CLASIFICACION" => SarebPaleta.Revision,
        _ => SarebPaleta.Neutro
    };

    // El ancho se interpola dentro de un atributo style, asi que tiene que salir
    // con punto decimal pase lo que pase: con la cultura espanola un double se
    // escribe "99,7" y el navegador descarta la regla entera, de modo que la
    // barra desaparecia y solo quedaba la leyenda. Dos decimales bastan y evitan
    // arrastrar un "99,71048060220035".
    private static string Ancho(int parte, int total)
    {
        var pct = total == 0 ? 0 : Math.Max(0.5, 100.0 * parte / total);
        return pct.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string Porcentaje(int parte, int total) =>
        total == 0 ? "" : $"{100.0 * parte / total:0.#}%";
}
