@using System.Globalization
@* Desglose por tipologia y por modelo. Ordenado por volumen de revision
   pendiente y no por volumen total: asi arriba queda donde merece la pena
   intervenir, aunque no sea lo mas frecuente. Los recuentos de calidad vienen ya
   calculados por confianza desde el backend (ver AgregadoGrupo). *@

<div class="row g-3 mb-4">
    @foreach (var panel in new[] { ("Por tipología", "Tipología", Tipologias), ("Por modelo", "Modelo", Modelos) })
    {
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header py-2">
                    <span class="fw-semibold">@panel.Item1</span>
                    <small class="text-muted ms-2">ordenado por revisión pendiente</small>
                </div>
                <div class="card-body p-0">
                    @if (panel.Item3.Count == 0)
                    {
                        <div class="p-3"><span class="text-muted small">Sin datos en el período</span></div>
                    }
                    else
                    {
                        <div style="max-height:280px;overflow-y:auto">
                            <table class="table table-sm table-hover mb-0" style="font-size:0.8rem">
                                <thead class="table-light" style="position:sticky;top:0;z-index:1">
                                    <tr>
                                        <th>@panel.Item2</th>
                                        <th class="text-end">Total</th>
                                        <th style="min-width:110px">Reparto por calidad</th>
                                        <th class="text-end">Rev.</th>
                                        <th class="text-end">Insuf.</th>
                                        <th class="text-end">Conf.</th>
                                        <th class="text-end">Dur.</th>
                                        <th class="text-center">FB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in Ordenar(panel.Item3))
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:150px" title="@g.Grupo">@g.Grupo</td>
                                            <td class="text-end fw-semibold">@g.Total</td>
                                            <td>
                                                <div class="d-flex rounded overflow-hidden" style="height:9px;gap:1px;background:#e9ecef">
                                                    @if (g.Ok > 0)
                                                    {
                                                        <div style="width:@Ancho(g.Ok, g.Total)%;background:#0ca30c" title="@g.Ok con confianza suficiente"></div>
                                                    }
                                                    @if (g.Revision > 0)
                                                    {
                                                        <div style="width:@Ancho(g.Revision, g.Total)%;background:#fab219" title="@g.Revision requieren revisión"></div>
                                                    }
                                                    @if (g.Error > 0)
                                                    {
                                                        <div style="width:@Ancho(g.Error, g.Total)%;background:#d03b3b" title="@g.Error con confianza insuficiente"></div>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-end @(g.Revision > 0 ? "fw-semibold" : "text-muted")">@g.Revision</td>
                                            <td class="text-end @(g.Error > 0 ? "fw-semibold text-danger" : "text-muted")">@g.Error</td>
                                            <td class="text-end">@(g.ConfianzaMedia > 0 ? g.ConfianzaMedia.ToString("P0") : "—")</td>
                                            <td class="text-end text-nowrap">@Duracion(g.DuracionMediaMs)</td>
                                            <td class="text-center">
                                                @if (g.Fallbacks > 0)
                                                {
                                                    <span class="badge" style="font-size:0.65rem;background:#fdf3dd;color:#7a5300">@g.Fallbacks</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public List<AgregadoGrupoDto> Tipologias { get; set; } = [];
    [Parameter] public List<AgregadoGrupoDto> Modelos { get; set; } = [];

    // A igualdad de revision pendiente decide el volumen, para que el orden sea
    // estable entre refrescos.
    private static List<AgregadoGrupoDto> Ordenar(List<AgregadoGrupoDto> items) =>
        items.OrderByDescending(g => g.Revision + g.Error)
             .ThenByDescending(g => g.Total)
             .ToList();

    // Punto decimal explicito: dentro de un atributo style, una coma invalida la
    // regla y la barra no se pinta.
    private static string Ancho(int parte, int total)
    {
        var pct = total == 0 ? 0 : Math.Max(0.5, 100.0 * parte / total);
        return pct.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string Duracion(double ms) =>
        ms <= 0 ? "—" : ms >= 1000 ? $"{Math.Round(ms / 1000.0, 1)} s" : $"{Math.Round(ms)} ms";
}
