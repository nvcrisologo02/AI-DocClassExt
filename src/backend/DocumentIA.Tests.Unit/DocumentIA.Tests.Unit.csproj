<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copia del catalogo que inserta scripts/migrations/costes-ia/01-seed-tarifas-ia.sql,
         para verificar que ese JSON es valido: el cargador es tolerante y un error de
         sintaxis dejaria el catalogo vacio en silencio (AB#100234). -->
    <None Include="catalogo-tarifas-produccion.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocumentIA.Core\DocumentIA.Core.csproj" />
    <ProjectReference Include="..\DocumentIA.Plugins\DocumentIA.Plugins.csproj" />
    <ProjectReference Include="..\DocumentIA.Functions\DocumentIA.Functions.csproj" />
  </ItemGroup>

</Project>
